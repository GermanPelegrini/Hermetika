{
  "name": "hermetika",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo for the Hermetika loyalty platform.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm --workspace @hermetika/web run dev",
    "dev:api": "npm --workspace @hermetika/api run dev",
    "dev:android": "npm --workspace @hermetika/android run dev",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "db:setup": "npm --workspace @hermetika/api run db:setup"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  }
}
